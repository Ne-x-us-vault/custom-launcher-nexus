/* Nexus Launcher - Rofi theme.
 *
 * Use with:  rofi -show drun -theme nexus
 * (install the file into ~/.local/share/rofi/themes/)
 */

* {
    font:                "Sans 11";
    background:          rgba(16, 67, 44, 0.82);
    background-alt:      rgba(9, 13, 17, 0.76);
    foreground:          rgba(246, 250, 252, 0.96);
    foreground-dim:      rgba(228, 239, 243, 0.74);
    accent:              rgba(232, 241, 246, 0.14);
    border-color:        rgba(236, 244, 248, 0.30);
    selected-bg:         rgba(232, 241, 246, 0.28);
    selected-fg:         rgba(246, 250, 252, 1.0);
}

window {
    width:                680px;
    height:               520px;
    border-radius:        24px;
    border:               1px solid @border-color;
    background-color:     @background;
    children:             [ mainbox ];
    padding:              0px;
}

mainbox {
    border-radius:        24px;
    padding:              28px;
    background-color:     transparent;
    children:             [ inputbar, listbox ];
    spacing:              20px;
}

inputbar {
    background-color:     @background-alt;
    border-radius:        999px;
    padding:              14px 18px;
    spacing:              12px;
    children:             [ entry ];
}

textbox-prompt-colon {
    enabled:              false;
}

entry {
    placeholder:          "Search";
    placeholder-color:    rgba(228, 239, 243, 0.55);
    foreground:           @foreground;
    background-color:     transparent;
}

listview {
    lines:                8;
    columns:              1;
    scrollbar:            false;
    background-color:     transparent;
    padding:              4px;
    spacing:              6px;
    dynamic:              true;
}

element {
    padding:              12px 14px;
    border-radius:        18px;
    background-color:     transparent;
    foreground:           @foreground;
}

element normal.normal {
    background-color:     transparent;
}

element selected.normal {
    background-color:     @selected-bg;
    foreground:           @selected-fg;
    border:               1px solid rgba(246, 250, 252, 0.46);
}

element-icon {
    size:                 38px;
}

element-text {
    horizontal-align:     0.5;
    vertical-align:       0.5;
    margin:               0px 0px 0px 14px;
}

scrollbar {
    width:                4px;
    border-radius:        999px;
    handle-color:         rgba(232, 241, 246, 0.38);
}

error-message {
    background-color:     @background;
    border-radius:        24px;
}
