# Maintainer: Ne-x-us-vault <https://github.com/Ne-x-us-vault>
pkgname=nexus-launcher
pkgver=1.0.0
pkgrel=1
pkgdesc="Frost-glass application launcher for GNOME Shell, other desktops, and Rofi"
arch=('any')
url="https://github.com/Ne-x-us-vault/custom-launcher-nexus"
license=('MIT')
depends=('gjs' 'gtk4' 'libadwaita' 'glib2')
optdepends=(
  'gnome-shell: enables the GNOME Shell extension'
  'rofi: matching Nexus Rofi theme'
)
install=nexus-launcher.install
source=("$pkgname-$pkgver.tar.gz::https://github.com/Ne-x-us-vault/custom-launcher-nexus/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

package() {
  local ext_uuid="custom-launcher@nexus.dev"
  local ext_src="$srcdir/custom-launcher-nexus-$pkgver/nexus-launcher@Ne-x-us-vault.github.io"

  install -Dm644 "$ext_src/extension.js" "$pkgdir/usr/share/gnome-shell/extensions/$ext_uuid/extension.js"
  install -Dm644 "$ext_src/prefs.js"    "$pkgdir/usr/share/gnome-shell/extensions/$ext_uuid/prefs.js"
  install -Dm644 "$ext_src/metadata.json"  "$pkgdir/usr/share/gnome-shell/extensions/$ext_uuid/metadata.json"
  install -Dm644 "$ext_src/stylesheet.css" "$pkgdir/usr/share/gnome-shell/extensions/$ext_uuid/stylesheet.css"
  cp -r "$ext_src/lib"    "$pkgdir/usr/share/gnome-shell/extensions/$ext_uuid/lib"
  cp -r "$ext_src/assets" "$pkgdir/usr/share/gnome-shell/extensions/$ext_uuid/assets"
  install -Dm644 "$ext_src/schemas/org.gnome.shell.extensions.nexus-launcher.gschema.xml" \
    "$pkgdir/usr/share/glib-2.0/schemas/org.gnome.shell.extensions.nexus-launcher.gschema.xml"

  install -Dm755 "$ext_src/bin/nexus-launcher.mjs" \
    "$pkgdir/usr/share/nexus-launcher/nexus-launcher.mjs"
  cp -r "$ext_src/assets" "$pkgdir/usr/share/nexus-launcher/assets"
  ln -s /usr/share/nexus-launcher/nexus-launcher.mjs "$pkgdir/usr/bin/nexus-launcher"

  install -Dm644 "$ext_src/rofi/nexus.rasi" "$pkgdir/usr/share/rofi/themes/nexus.rasi"

  cat > "$pkgdir/usr/share/applications/nexus-launcher.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=Nexus Launcher
Comment=Frost-glass application launcher (standalone)
Exec=/usr/bin/nexus-launcher
Icon=system-search
Terminal=false
Categories=Utility;System;
Keywords=launcher;search;apps;run;
EOF
}
