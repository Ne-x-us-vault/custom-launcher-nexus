#!/bin/sh
set -e

# Compile the schema so GSettings can read the extension's settings.
if command -v glib-compile-schemas >/dev/null 2>&1; then
    glib-compile-schemas /usr/share/glib-2.0/schemas
fi

# Note: the extension is NOT enabled here. Package maintainer scripts run as
# root with no GNOME session, so `gnome-extensions enable` cannot reach the
# user's shell. Enable it once after login with:
#   gnome-extensions enable custom-launcher@nexus.dev

exit 0
